{
  "name": "elenskye-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build:site": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "index:search": "pagefind --site dist",
    "watermark": "node scripts/watermark.mjs",
    "watermark:dist": "node scripts/watermark.mjs --dist",
    "build": "npm run build:site && npm run watermark:dist && npm run index:search",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "check": "tsc --noEmit",
    "audit:assets": "node scripts/audit-assets.mjs",
    "assets:delete-preview": "node scripts/asset-deletion-preview.mjs",
    "qa:refs": "node scripts/qa-references.mjs",
    "qa:career": "node scripts/qa-career.mjs",
    "qa:discovery": "node scripts/qa-discovery.mjs",
    "qa:wander": "node scripts/qa-wander.mjs",
    "qa:taxonomy": "node scripts/qa-taxonomy.mjs",
    "qa": "npm run qa:workspace && npm run build && npm run check && npm run audit:assets && npm run qa:refs && node scripts/qa-build.mjs && npm run qa:career && npm run qa:wander && npm run qa:taxonomy && npm run qa:discovery",
    "qa:workspace": "node scripts/qa-workspace.mjs"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.19",
    "@types/three": "^0.185.4",
    "astro": "^7.1.3",
    "js-yaml": "^4.3.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@lucide/astro": "^1.26.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.3",
    "three": "^0.185.1"
  }
}
