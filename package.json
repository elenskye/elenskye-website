{
  "name": "elenskye-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build:site": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "index:search": "pagefind --site dist",
    "index:search:vercel": "pagefind --site .vercel/output/static",
    "build": "npm run build:site && npm run index:search",
    "build:remote-check": "KEYSTATIC_STORAGE=github KEYSTATIC_GITHUB_REPO=elenskye/elenskye-website DEPLOY_TARGET=vercel ASTRO_TELEMETRY_DISABLED=1 astro build && npm run index:search:vercel && node scripts/qa-remote-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "check": "tsc --noEmit",
    "audit:assets": "node scripts/audit-assets.mjs",
    "assets:delete-preview": "node scripts/asset-deletion-preview.mjs",
    "qa:admin": "node scripts/qa-admin-references.mjs",
    "qa:career": "node scripts/qa-career.mjs",
    "qa:discovery": "node scripts/qa-discovery.mjs",
    "qa:wander": "node scripts/qa-wander.mjs",
    "qa:taxonomy": "node scripts/qa-taxonomy.mjs",
    "qa": "npm run qa:workspace && npm run build && npm run check && npm run audit:assets && npm run qa:admin && node scripts/qa-build.mjs && npm run qa:career && npm run qa:wander && npm run qa:taxonomy && npm run qa:discovery",
    "qa:workspace": "node scripts/qa-workspace.mjs"
  },
  "devDependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vercel": "^11.0.3",
    "@types/three": "^0.185.4",
    "astro": "^7.1.3",
    "js-yaml": "^4.3.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/react": "^6.0.1",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.5.51",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  }
}
