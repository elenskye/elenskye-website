---
import SearchPanel from '../components/SearchPanel.astro';
import { discoveryPaths, pageCopy } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSearchDocuments } from '../lib/search-documents';

const page = pageCopy.zh.search;
const documents = await getSearchDocuments('zh');
---

<BaseLayout
  title="站内搜索 | Elen Skye"
  description={page.description}
  locale="zh"
  path={discoveryPaths.search.zh}
  alternatePath={discoveryPaths.search.en}
  xDefaultPath={discoveryPaths.search.zh}
>
  <main id="main-content" tabindex="-1" class="page-shell page-shell--narrow search-page">
    <p class="page-eyebrow">{page.eyebrow}</p>
    <h1>{page.title}</h1>
    <SearchPanel locale="zh" documents={documents} />
  </main>
</BaseLayout>
