---
import PageShell from '../../components/PageShell.astro';
import SearchPanel from '../../components/SearchPanel.astro';
import { discoveryPaths, pageCopy } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSearchDocuments } from '../../lib/search-documents';

const page = pageCopy.en.search;
const documents = await getSearchDocuments('en');
---

<BaseLayout
  title="Search | Elen Skye"
  description={page.description}
  locale="en"
  path={discoveryPaths.search.en}
  alternatePath={discoveryPaths.search.zh}
  xDefaultPath={discoveryPaths.search.zh}
>
  <PageShell eyebrow={page.eyebrow} title={page.title} description={page.description} variant="narrow" class="search-page">
    <SearchPanel locale="en" documents={documents} />
  </PageShell>
</BaseLayout>
