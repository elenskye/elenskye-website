---
import {
  BookOpen,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Flag,
  Image,
  PenLine,
  Route,
  type AstroComponent,
} from '@lucide/astro';
import { filterBarCopy, wanderCategories, wanderTopics, type Locale } from '../data/site';
import { WANDER_WALL_LIMIT } from '../lib/wander-filter.js';
import type { WanderCard } from '../lib/wander';
import ContentLabel from './ContentLabel.astro';
import glyphCreate from '../vendor/vermilion/category-glyph-hover/create.fragment.html?raw';
import glyphGallery from '../vendor/vermilion/category-glyph-hover/gallery.fragment.html?raw';
import glyphProject from '../vendor/vermilion/category-glyph-hover/project.fragment.html?raw';
import glyphWrite from '../vendor/vermilion/category-glyph-hover/write.fragment.html?raw';
import emptyGraphic from '../vendor/vermilion/empty-graphic.svg?raw';

interface Props {
  cards: WanderCard[];
  emptyText: string;
  locale: Locale;
  categoryCounts: Record<string, number>;
}

const { cards, emptyText, locale, categoryCounts } = Astro.props;
const copy = filterBarCopy[locale];

// The wall shows the newest cards up to this cap; the rest stay hidden
// behind an expand button.
const hasOverflow = cards.length > WANDER_WALL_LIMIT;
const expandLabel = locale === 'zh' ? `展开全部（${cards.length}）` : `Show all (${cards.length})`;
const categoryPanelId = `wander-category-panel-${locale}`;
const firstImageCardIndex = cards.findIndex((card) => Boolean(card.thumbnail));

// Lucide owns generic interface icons; the custom wandering-path mark remains
// a separate brand asset. Keys must match the Category slugs in
// src/data/wander-taxonomy.json; an unmapped or retired slug falls back to
// the Route icon at the call site, so this map never needs stale entries.
const categoryIcons: Record<string, AstroComponent> = {
  notes: PenLine,
  project: Flag,
  literature: BookOpen,
  gallery: Image,
};

// Vermilion category glyphs (synced from visual-atelier into src/vendor/vermilion/)
// replace the Lucide icon wherever the category has one; hovering or focusing
// the card writes the glyph. Each inline glyph carries SVG masks, so the id
// prefix is made unique per card. The travel and other glyphs stay unused until
// the taxonomy grows.
const categoryGlyphs: Record<string, { name: string; html: string }> = {
  notes: { name: 'write', html: glyphWrite },
  project: { name: 'project', html: glyphProject },
  gallery: { name: 'gallery', html: glyphGallery },
  literature: { name: 'create', html: glyphCreate },
};
const glyphFor = (category: string, key: string, className: string) => {
  const glyph = categoryGlyphs[category];
  if (!glyph) return undefined;
  return glyph.html
    .replace(/<!--[\s\S]*?-->\s*/, '')
    .replaceAll(`va-glyph-${glyph.name}-solo`, `va-glyph-${locale}-${key}`)
    .replace('class="va-glyph"', `class="va-glyph ${className}"`);
};
// The empty state is a surface box, so the paper takes the on-surface fill.
const emptyIllustration = emptyGraphic.replace(
  '<svg ',
  '<svg class="va-graphic va-on-surface status-illustration status-illustration--empty" focusable="false" '
);

const arrowLabels =
  locale === 'zh' ? { prev: '向左滚动话题', next: '向右滚动话题' } : { prev: 'Scroll topics left', next: 'Scroll topics right' };
---

{
  cards.length > 0 ? (
    <>
      <div class="wander-filter">
        <div class="filter-topics">
          <span class="filter-eyebrow">{copy.topics}</span>
          <button class="topic-arrow" type="button" data-topic-scroll="-1" aria-label={arrowLabels.prev}>
            <ChevronLeft aria-hidden="true" size={15} stroke-width={1.8} />
          </button>
          <div class="topic-scroll va-slide" data-topic-track>
            {wanderTopics.map((topic) => (
              <button class="topic-chip" type="button" data-topic={topic.slug} aria-pressed="false">
                {topic.label[locale]}
              </button>
            ))}
            <span class="va-slide-indicator" aria-hidden="true"></span>
          </div>
          <button class="topic-arrow" type="button" data-topic-scroll="1" aria-label={arrowLabels.next}>
            <ChevronRight aria-hidden="true" size={15} stroke-width={1.8} />
          </button>
        </div>
        <div class="filter-category" data-all-label={copy.allCategories} data-selected-suffix={copy.selectedSuffix}>
          <button class="category-toggle" type="button" aria-haspopup="true" aria-expanded="false" aria-controls={categoryPanelId}>
            <span class="category-toggle-label">{copy.allCategories}</span>
            <ChevronDown aria-hidden="true" size={15} stroke-width={1.8} />
          </button>
          <div class="category-panel" id={categoryPanelId} hidden>
            <button class="category-clear" type="button">{copy.allCategories}</button>
            {wanderCategories.map((category) => (
              <label class="category-option">
                <input type="checkbox" value={category.slug} />
                <span class="category-option-label">{category.label[locale]}</span>
                <span class="category-option-count">{categoryCounts[category.slug] ?? 0}</span>
              </label>
            ))}
          </div>
        </div>
      </div>
      <section class="wander-wall" aria-label="Wander content wall">
        {cards.map((card, index) => {
          const variant = card.thumbnail ? 'wander-card--image' : 'wander-card--plain';
          const overflow = index >= WANDER_WALL_LIMIT;
          const CardIcon = categoryIcons[card.category] ?? Route;
          const glyph = glyphFor(card.category, String(index), card.thumbnail ? 'wander-card-glyph wander-card-glyph--fallback' : 'wander-card-glyph');
          return (
            <a
              class:list={['wander-card', variant, { 'va-glyph-trigger': glyph }]}
              data-category={card.category}
              data-topics={card.topics.join(',')}
              data-overflow={overflow ? 'true' : undefined}
              hidden={overflow}
              href={card.href}
            >
              {card.thumbnail ? (
                <>
                  <figure class="wander-card-media">
                    <img
                      src={card.thumbnail}
                      alt={card.title}
                      loading={index === firstImageCardIndex ? 'eager' : 'lazy'}
                      fetchpriority={index === firstImageCardIndex ? 'high' : undefined}
                      decoding="async"
                    />
                  </figure>
                  {glyph ? (
                    <Fragment set:html={glyph} />
                  ) : (
                    <span class="wander-card-icon wander-card-icon--fallback">
                      <CardIcon aria-hidden="true" size={22} stroke-width={1.8} />
                    </span>
                  )}
                </>
              ) : glyph ? (
                <Fragment set:html={glyph} />
              ) : (
                <span class="wander-card-icon">
                  <CardIcon aria-hidden="true" size={22} stroke-width={1.8} />
                </span>
              )}
              <div class="wander-card-body">
                <h2>{card.title}</h2>
                <p>{card.summary}</p>
                <div class="wander-card-meta">
                  {card.categoryLabel && <ContentLabel label={card.categoryLabel} />}
                  <span>{card.languageLabel}</span>
                  {card.dateLabel && <span>{card.dateLabel}</span>}
                </div>
              </div>
            </a>
          );
        })}
      </section>
      {
        hasOverflow && (
          <div class="wander-expand">
            <button class="button-link" type="button" data-expand-wall>
              {expandLabel}
            </button>
          </div>
        )
      }
      <section class="wander-empty" data-filter-empty hidden role="status" aria-live="polite">
        <Fragment set:html={emptyIllustration} />
        <p>{locale === 'zh' ? '没有符合当前筛选的内容。' : 'Nothing matches the current filters.'}</p>
      </section>
      <script>
        import '../scripts/wander-wall';
      </script>
    </>
  ) : (
    <section class="wander-empty" aria-label="Empty Wander state">
      <Fragment set:html={emptyIllustration} />
      <p>{emptyText}</p>
    </section>
  )
}
